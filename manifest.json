{
  "manifest_version": 3,
  "name": "Infinite Page Zoom",
  "version": "1.1.0",
  "description": "Zoom the current page in or out with any signed numeric value.",
  "action": {
    "default_title": "Infinite Page Zoom",
    "default_popup": "popup/index.html"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "infinite-page-zoom@example.com",
      "strict_min_version": "109.0"
    }
  }
}
